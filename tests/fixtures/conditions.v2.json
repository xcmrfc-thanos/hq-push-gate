{
  "version": 2,
  "description": "Condition schema v2 共享用例集（ADR-042）。单一事实源：pytest(ai-query 查询侧)/JUnit(biz 规则侧)/vitest(@hq/shared，B26) 三端消费。查询侧条件含 type 字段；规则侧 type 在 RuleMsg.ruleType、condition JSON 不含 type。canonical 为规范化形态（负幅值归一为 direction=down、未指定字段省略）。",
  "valid_query": [
    { "name": "price_above_min", "input": { "type": "PRICE_ABOVE", "threshold": 12.5 },
      "canonical": { "type": "PRICE_ABOVE", "threshold": 12.5 } },
    { "name": "price_above_overlay", "input": { "type": "PRICE_ABOVE", "threshold": 100, "once": true, "session": "open", "expire_at": 1730000000000 },
      "canonical": { "type": "PRICE_ABOVE", "threshold": 100, "once": true, "session": "open", "expire_at": 1730000000000 } },
    { "name": "price_below", "input": { "type": "PRICE_BELOW", "threshold": 5 },
      "canonical": { "type": "PRICE_BELOW", "threshold": 5 } },
    { "name": "price_range", "input": { "type": "PRICE_RANGE", "low": 10, "high": 20 },
      "canonical": { "type": "PRICE_RANGE", "low": 10, "high": 20 } },
    { "name": "pct_both_default", "input": { "type": "PCT_CHANGE", "threshold": 5 },
      "canonical": { "type": "PCT_CHANGE", "threshold": 5 } },
    { "name": "pct_signed_down_normalized", "input": { "type": "PCT_CHANGE", "threshold": -5 },
      "canonical": { "type": "PCT_CHANGE", "threshold": 5, "direction": "down" } },
    { "name": "pct_up_explicit", "input": { "type": "PCT_CHANGE", "threshold": 5, "direction": "up" },
      "canonical": { "type": "PCT_CHANGE", "threshold": 5, "direction": "up" } },
    { "name": "pct_limit_up", "input": { "type": "PCT_CHANGE", "threshold": 9.8, "direction": "up", "limit": true },
      "canonical": { "type": "PCT_CHANGE", "threshold": 9.8, "direction": "up", "limit": true } },
    { "name": "volume_above", "input": { "type": "VOLUME_ABOVE", "threshold": 1000000 },
      "canonical": { "type": "VOLUME_ABOVE", "threshold": 1000000 } },
    { "name": "group_all_depth1", "input": { "all": [ { "type": "PCT_CHANGE", "threshold": 5, "direction": "up" }, { "type": "PRICE_ABOVE", "threshold": 10 } ] },
      "canonical": { "all": [ { "type": "PCT_CHANGE", "threshold": 5, "direction": "up" }, { "type": "PRICE_ABOVE", "threshold": 10 } ] } },
    { "name": "group_nested_depth2", "input": { "any": [ { "type": "VOLUME_ABOVE", "threshold": 1000000 }, { "all": [ { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_BELOW", "threshold": 2 } ] } ] },
      "canonical": { "any": [ { "type": "VOLUME_ABOVE", "threshold": 1000000 }, { "all": [ { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_BELOW", "threshold": 2 } ] } ] } }
  ],
  "invalid_query": [
    { "name": "unknown_type", "input": { "type": "UNKNOWN" } },
    { "name": "indicator_unsupported_in_query", "input": { "type": "INDICATOR", "indicator": "RSI", "op": ">", "value": 80 } },
    { "name": "missing_threshold", "input": { "type": "PRICE_ABOVE" } },
    { "name": "negative_price", "input": { "type": "PRICE_ABOVE", "threshold": -1 } },
    { "name": "range_inverted", "input": { "type": "PRICE_RANGE", "low": 20, "high": 10 } },
    { "name": "pct_zero", "input": { "type": "PCT_CHANGE", "threshold": 0 } },
    { "name": "pct_overflow", "input": { "type": "PCT_CHANGE", "threshold": 101 } },
    { "name": "pct_negative_up_conflict", "input": { "type": "PCT_CHANGE", "threshold": -5, "direction": "up" } },
    { "name": "pct_limit_missing_direction", "input": { "type": "PCT_CHANGE", "threshold": 5, "limit": true } },
    { "name": "pct_limit_both_rejected", "input": { "type": "PCT_CHANGE", "threshold": 5, "limit": true, "direction": "both" } },
    { "name": "group_depth3", "input": { "all": [ { "all": [ { "all": [ { "type": "PRICE_ABOVE", "threshold": 1 } ] } ] } ] } },
    { "name": "group_empty", "input": { "all": [] } },
    { "name": "group_both_joiners", "input": { "all": [ { "type": "PRICE_ABOVE", "threshold": 1 } ], "any": [ { "type": "PRICE_BELOW", "threshold": 2 } ] } },
    { "name": "group_oversize", "input": { "all": [ { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 }, { "type": "PRICE_ABOVE", "threshold": 1 } ] } },
    { "name": "leaf_group_ambiguous", "input": { "type": "PRICE_ABOVE", "threshold": 1, "all": [] } },
    { "name": "injection_flavored_type", "input": { "type": "EVIL", "threshold": "1; DROP TABLE tick_local" } }
  ],
  "valid_rule": [
    { "name": "rule_price_above", "ruleType": "PRICE_ABOVE", "input": { "threshold": 12.5 },
      "canonical": { "threshold": 12.5 } },
    { "name": "rule_price_range_overlay", "ruleType": "PRICE_RANGE", "input": { "low": 10, "high": 20, "once": true },
      "canonical": { "low": 10, "high": 20, "once": true } },
    { "name": "rule_pct_signed_down_normalized", "ruleType": "PCT_CHANGE", "input": { "threshold": -5 },
      "canonical": { "threshold": 5, "direction": "down" } },
    { "name": "rule_pct_direction_up", "ruleType": "PCT_CHANGE", "input": { "threshold": 5, "direction": "up" },
      "canonical": { "threshold": 5, "direction": "up" } },
    { "name": "rule_pct_limit_up", "ruleType": "PCT_CHANGE", "input": { "threshold": 9.8, "direction": "up", "limit": true },
      "canonical": { "threshold": 9.8, "direction": "up", "limit": true } },
    { "name": "rule_indicator_volume", "ruleType": "INDICATOR", "input": { "indicator": "VOLUME", "op": ">", "value": 1000000 },
      "canonical": { "indicator": "VOLUME", "op": ">", "value": 1000000 } }
  ],
  "invalid_rule": [
    { "name": "rule_unknown_type", "ruleType": "FOO", "input": { "threshold": 1 } },
    { "name": "rule_group_rejected", "ruleType": "PCT_CHANGE", "input": { "all": [ { "threshold": 5 } ] } },
    { "name": "rule_pct_zero", "ruleType": "PCT_CHANGE", "input": { "threshold": 0 } },
    { "name": "rule_pct_overflow", "ruleType": "PCT_CHANGE", "input": { "threshold": 101 } },
    { "name": "rule_pct_negative_up_conflict", "ruleType": "PCT_CHANGE", "input": { "threshold": -5, "direction": "up" } },
    { "name": "rule_pct_limit_missing_direction", "ruleType": "PCT_CHANGE", "input": { "threshold": 5, "limit": true } },
    { "name": "rule_price_missing_threshold", "ruleType": "PRICE_ABOVE", "input": {} },
    { "name": "rule_range_inverted", "ruleType": "PRICE_RANGE", "input": { "low": 20, "high": 10 } },
    { "name": "rule_indicator_non_volume", "ruleType": "INDICATOR", "input": { "indicator": "RSI", "op": ">", "value": 80 } },
    { "name": "rule_indicator_bad_op", "ruleType": "INDICATOR", "input": { "indicator": "VOLUME", "op": "<", "value": 100 } },
    { "name": "rule_overlay_bad_session", "ruleType": "PRICE_ABOVE", "input": { "threshold": 1, "session": "always" } },
    { "name": "rule_overlay_bad_expire", "ruleType": "PRICE_ABOVE", "input": { "threshold": 1, "expire_at": -1 } }
  ]
}
